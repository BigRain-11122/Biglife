# Runtime & local state
state/
logs/
*.log

# R3 regenerable export faces (rebuild on demand via Tools/needs.py / behavior.py / atlas_manifest.py, ~3s/10k)
census/export/citizen-needs.jsonl
census/export/citizen-behavior.jsonl
census/export/citizen-atlas.jsonl
census/export/citizen-voice.jsonl
census/export/citizen-tasks.jsonl
census/export/citizen-persona.jsonl
census/export/citizen-initiatives.jsonl
census/export/citizen-relations.jsonl
census/export/citizen-goals.jsonl
census/export/citizen-anchors.jsonl
census/export/citizen-assembly.jsonl
census/export/voice-cache/
# Codely runtime (mirrors HQ gitignore law)
.codely-cli/settings.local.json
.codely-cli/auto-saves/
.codely-cli/scheduled_tasks.json
# Python
__pycache__/
*.pyc

# QA smoke evidence (charter qa-smoke-test v1.0: qa/ 证据入库复查·白名单豁免 *.log)
!qa/*.log

# Event shards derived from census cards (regenerable: Tools/events_derive.py)
events/*
# 例外：街区日常母题池是年轮线的输入素材（非 census 派生），按日确定性生成、
# 需入库供跨机与 CEO 过程可见（T-20261112-01 修法②）。
!events/life/
!events/life/*.jsonl
.codely-cli/
