{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biglife:citizens-light.v1.2.json",
  "title": "citizens-light.jsonl row (census/export, v1.2 ring-mirror face)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "species", "faction", "gender", "age", "age_note",
               "district", "block", "profession", "axis", "creed", "hook",
               "behavior_hint", "brain_digest", "recent_ring",
               "recent_ring_date", "v"],
  "properties": {
    "id": {"type": "string", "pattern": "^C-\\d{5}$"},
    "name": {"type": "string", "minLength": 1},
    "species": {"type": "string", "minLength": 2},
    "faction": {"type": "string", "minLength": 2},
    "gender": {"type": "string", "minLength": 1},
    "age": {"type": ["integer", "null"], "minimum": 0},
    "age_note": {"type": ["string", "null"]},
    "district": {"type": "string"},
    "block": {"type": "string"},
    "profession": {"type": "string"},
    "axis": {"type": ["string", "null"]},
    "creed": {"type": "string"},
    "hook": {"type": "string"},
    "behavior_hint": {"type": "string"},
    "anchor": {"type": "string"},
    "anchor": {"type": "boolean", "description": "optional: true on hand-written anchor cards + honored seats (23 rows)"},
    "brain_digest": {"type": "string"},
    "recent_ring": {"type": "string", "maxLength": 80},
    "recent_ring_date": {"type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"},
    "v": {"type": "number", "minimum": 1}
  }
}
