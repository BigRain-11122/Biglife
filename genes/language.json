  "catchphrases": [
    {"text": "慢慢来，比较快。", "axis": "逍遥"},
    {"text": "急啥，汤还没开呢。", "axis": "烟火"},
    {"text": "今天的事今天清。", "axis": "秩序"},
    {"text": "先试了再说。", "axis": "求新"},
    {"text": "老规矩错不了。", "axis": "怀旧"},
    {"text": "包在我身上。", "axis": "侠气"},
    {"text": "这事儿有讲究。", "axis": "烟火"},
    {"text": "稳住，别浪。", "axis": "秩序"},
    {"text": "有意思，我想想。", "axis": "求新"},
    {"text": "十年前就是这么弄的。", "axis": "怀旧"},
    {"text": "谁的事就是谁的事，可街坊的事就是我的事。", "axis": "侠气"},
    {"text": "看天吃饭，看行情穿衣。", "axis": "逍遥"},
    {"text": "火候到了自然就香。", "axis": "烟火"},
    {"text": "数据不会骗人，人会。", "axis": "秩序"},
    {"text": "新东西先看三天再用。", "axis": "求新"},
    {"text": "旧的用的顺手。", "axis": "怀旧"},
    {"text": "搭把手的事儿。", "axis": "侠气"},
    {"text": "潮水的事交给潮水。", "axis": "逍遥"},
    {"text": "出锅喽——", "axis": "烟火"},
    {"text": "对时了，放心。", "axis": "秩序"},
    {"text": "这版本我等好久了。", "axis": "求新"},
    {"text": "弄堂还是那个弄堂。", "axis": "怀旧"},
    {"text": "一句话的事。", "axis": "侠气"},
    {"text": "茶凉了再倒就是。", "axis": "逍遥"},
    {"text": "趁热吃。", "axis": "烟火"},
    {"text": "红灯面前没有老熟人。", "axis": "秩序"},
    {"text": "拆开看看又不会坏。", "axis": "求新"},
    {"text": "老地方见。", "axis": "怀旧"},
    {"text": "别客气，就当自己家。", "axis": "侠气"},
    {"text": "明儿又是新的一天。", "axis": "逍遥"},
    {"text": "多个人多双筷子。", "axis": "烟火"},
    {"text": "清单第一。", "axis": "秩序"},
    {"text": "灵感这东西，得喂它。", "axis": "求新"},
    {"text": "这物件比我懂年头。", "axis": "怀旧"},
    {"text": "夜里冷，喝口热的再走。", "axis": "侠气"},
    {"text": "江水都不急我急啥。", "axis": "逍遥"},
    {"text": "收摊了，明天见。", "axis": "烟火"},
    {"text": "毫秒也是时间。", "axis": "秩序"},
    {"text": "试错要趁灯亮。", "axis": "求新"},
    {"text": "灯还是老灯亮堂。", "axis": "怀旧"},
    {"text": "这单我送，别跟我抢。", "axis": "侠气"},
    {"text": "看云不用门票。", "axis": "逍遥"},
    {"text": "汤要趁烫，话要慢讲。", "axis": "烟火"},
    {"text": "先复核一遍。", "axis": "秩序"},
    {"text": "又学了一招。", "axis": "求新"},
    {"text": "以前我们那儿……", "axis": "怀旧"},
    {"text": "站直了别趴下。", "axis": "侠气"},
    {"text": "船到桥头自然直。", "axis": "逍遥"},
    {"text": "灶上有汤，自取。", "axis": "烟火"},
    {"text": "规矩如钟，人情如江。", "axis": "秩序"},
    {"text": "下一版一定更好。", "axis": "求新"},
    {"text": "旧钥匙开新锁，有时候还真开得开。", "axis": "怀旧"},
    {"text": "街坊一声喊，放下碗就到。", "axis": "侠气"},
    {"text": "今天云好，改天再说。", "axis": "逍遥"},
    {"text": "饭点了，天大的事吃完再谈。", "axis": "烟火"},
    {"text": "门禁亮绿灯，心里才亮堂。", "axis": "秩序"},
    {"text": "这城里好玩的东西一天比一天多。", "axis": "求新"},
    {"text": "我送走的老主顾，比这城里一半的楼岁数都大。", "axis": "怀旧"},
    {"text": "谁没个难处呢，来，坐下说。", "axis": "侠气"},
    {"text": "单子来了就接，不来就钓鱼。", "axis": "逍遥"},
    {"text": "慢船也是船。", "axis": "逍遥"},
    {"text": "锅气比道理管用。", "axis": "烟火"},
    {"text": "先归档，再感慨。", "axis": "秩序"},
    {"text": "新灯头一晚，总得有人多看两眼。", "axis": "求新"},
    {"text": "老钟走得慢，可它没停过。", "axis": "怀旧"},
    {"text": "伞大，站过来点。", "axis": "侠气"},
    {"text": "坐得住的人，等得起事。", "axis": "逍遥"},
    {"text": "一碗热汤，万事好商量。", "axis": "烟火"},
    {"text": "编号不乱，心就不乱。", "axis": "秩序"},
    {"text": "换个思路，山就开了个口。", "axis": "求新"},
    {"text": "修修补补又一年。", "axis": "怀旧"},
    {"text": "吃亏的事，总得有人先做。", "axis": "侠气"},
    {"text": "忙有忙的过法，闲有闲的过法。", "axis": "逍遥"},
    {"text": "料要足，话要实。", "axis": "烟火"},
    {"text": "差一点都不算数。", "axis": "秩序"},
    {"text": "没见过的，都值得看一眼。", "axis": "求新"},
    {"text": "老底子的味道，改不得。", "axis": "怀旧"},
    {"text": "该出手时不含糊。", "axis": "侠气"},
    {"text": "闲是本事，忙是本分。", "axis": "逍遥"},
    {"text": "锅气就是人气。", "axis": "烟火"},
    {"text": "规矩在，心不慌。", "axis": "秩序"},
    {"text": "新东西，先摸摸脾气。", "axis": "求新"},
    {"text": "旧物件里住着老日子。", "axis": "怀旧"},
    {"text": "帮人帮到底，送佛送到西。", "axis": "侠气"},
    {"text": "走一步，看一步，步步都算数。", "axis": "逍遥"},
    {"text": "烟火气里没有过不去的坎。", "axis": "烟火"},
    {"text": "账要日日清，心才稳稳当。", "axis": "秩序"},
    {"text": "新花样的门，总朝敢敲的人开。", "axis": "求新"},
    {"text": "老手艺不怕新日子。", "axis": "怀旧"},
    {"text": "能帮一把是一把，帮完不留名。", "axis": "侠气"},
    {"text": "闲下来，才是过日子的本事。", "axis": "逍遥"},
    {"text": "热汤落肚，啥事都好商量。", "axis": "烟火"},
    {"text": "按点做事，心里踏实。", "axis": "秩序"},
    {"text": "学一样新的，这天就不算白过。", "axis": "求新"},
    {"text": "老味道，是攒在舌头的日历。", "axis": "怀旧"},
    {"text": "该搭手就搭手，别站边上看着。", "axis": "侠气"},
    {"text": "慢火煨出来的日子，最养人。", "axis": "逍遥"},
    {"text": "油盐酱醋里，藏着一天的心意。", "axis": "烟火"},
    {"text": "东西归了位，心也跟着归位。", "axis": "秩序"},
    {"text": "没玩过的新鲜事，排在日子前头。", "axis": "求新"},
    {"text": "旧日子里翻出来的，都是宝贝。", "axis": "怀旧"},
    {"text": "能搭手的地方，绝不站干岸。", "axis": "侠气"},
    {"text": "不赶路的人，看得见街角的热闹。", "axis": "逍遥"},
    {"text": "锅铲一响，家就热了。", "axis": "烟火"},
    {"text": "账清了，觉才睡得香。", "axis": "秩序"},
    {"text": "没走过的路，才值得拐个弯。", "axis": "求新"},
    {"text": "老歌一响，人就回了旧时光。", "axis": "怀旧"},
    {"text": "应了人家的事，就得办到底。", "axis": "侠气"},
    {"text": "闲着的时候，日子才算自己的。", "axis": "逍遥"},
    {"text": "热汤热菜，才叫过日子。", "axis": "烟火"},
    {"text": "差一星半点，都不算齐整。", "axis": "秩序"},
    {"text": "没见过的花样，都值得试一试。", "axis": "求新"},
    {"text": "旧物件擦一擦，又是新光景。", "axis": "怀旧"},
    {"text": "路见不平，搭把手再说。", "axis": "侠气"},
    {"text": "兴之所至，就是最好的安排。", "axis": "逍遥"},
    {"text": "灶上不熄火，日子就有奔头。", "axis": "烟火"},
    {"text": "先来后到，心里都有杆秤。", "axis": "秩序"},
    {"text": "新念头别搁着，搁着就凉了。", "axis": "求新"},
    {"text": "老街坊的一句问候，暖过新棉袄。", "axis": "怀旧"},
    {"text": "帮人不挑日子，碰上了就是缘分。", "axis": "侠气"},
    {"text": "日子长着呢，不差这一时半刻。", "axis": "逍遥"},
    {"text": "柴米油盐上心，粗茶淡饭养人。", "axis": "烟火"},
    {"text": "一是一，二是二，账不能混。", "axis": "秩序"},
    {"text": "头一回见的东西，总要多看两眼。", "axis": "求新"},
    {"text": "老地方坐一坐，比啥都解乏。", "axis": "怀旧"},
    {"text": "护着小的，敬着老的，帮衬街坊是本分。", "axis": "侠气"},
{"text": "日子是过出来的，不是赶出来的。", "axis": "逍遥"},
{"text": "灶上炖着汤，心里就有底。", "axis": "烟火"},
{"text": "规矩立在先，省得后头乱。", "axis": "秩序"},
{"text": "城里天天有新事，耳朵得支棱着。", "axis": "求新"},
{"text": "压箱底的旧衣裳，藏着当年的针脚。", "axis": "怀旧"},
{"text": "街坊的事，赶巧碰上就不能装没看见。", "axis": "侠气"},
{"text": "心闲了，脚步就慢了。", "axis": "逍遥"},
{"text": "一口热乎的，抵过千句虚的。", "axis": "烟火"},
{"text": "先后排好，日子不挤。", "axis": "秩序"},
{"text": "新门道，摸清了再进门。", "axis": "求新"},
{"text": "老照片泛黄，故事才上色。", "axis": "怀旧"},
{"text": "仗义不是力气大，是肯站出来。", "axis": "侠气"},
{"text": "日子松一点，才有滋味。", "axis": "逍遥"},
{"text": "菜香引路，人心进门。", "axis": "烟火"},
{"text": "该在的位置，一样不能少。", "axis": "秩序"},
{"text": "没尝过的味，才值得下筷子。", "axis": "求新"},
{"text": "旧日子的甜，新糖换不来。", "axis": "怀旧"},
{"text": "该管的闲事，管到底才踏实。", "axis": "侠气"},
{"text": "闲下来，街角坐坐，就是好日子。", "axis": "逍遥"},
{"text": "饭要一口口吃，事要一件件办。", "axis": "烟火"},
{"text": "东西有定位，日子有准头。", "axis": "秩序"},
{"text": "新面孔新物件，都值得多聊两句。", "axis": "求新"},
{"text": "老曲子里，藏着回不去的好时候。", "axis": "怀旧"},
{"text": "谁家屋顶漏了，先帮着补上再说。", "axis": "侠气"},
{"text": "坐得住的人，才看得见变化。", "axis": "逍遥"},
{"text": "热汤下肚，啥事都好商量。", "axis": "烟火"},
{"text": "定好的规矩，一个字都不改。", "axis": "秩序"},
{"text": "新的路子，先试一脚再说。", "axis": "求新"},
{"text": "旧味道，是回家的路标。", "axis": "怀旧"},
{"text": "路见不平，搭把手总没错。", "axis": "侠气"},
{"text": "慢半拍不丢人，丢方向才丢人。", "axis": "逍遥"},
{"text": "锅气一上来，人就不生分了。", "axis": "烟火"},
{"text": "规矩立得住，人才站得稳。", "axis": "秩序"},
{"text": "新路数没试过，手就先痒了。", "axis": "求新"},
{"text": "老歌一响，日子就回来了。", "axis": "怀旧"},
{"text": "仗义不是脾气，是习惯。", "axis": "侠气"},
{"text": "脚步一停，日子就宽了。", "axis": "逍遥"},
{"text": "灶台热着，家里就不冷清。", "axis": "烟火"},
{"text": "小账天天对，大账不糊涂。", "axis": "秩序"},
{"text": "好奇心不花钱，还能生利息。", "axis": "求新"},
{"text": "老街坊的门槛，越坐越亮。", "axis": "怀旧"},
{"text": "搭不上手的忙，递句话也是帮。", "axis": "侠气"},
{"text": "晃晃悠悠过一天，也是正经日子。", "axis": "逍遥"},
{"text": "饭桌摆开了，人就都到齐了。", "axis": "烟火"},
{"text": "台账翻一遍，桩桩有着落。", "axis": "秩序"},
{"text": "新铺子开张，得头一个去捧场。", "axis": "求新"},
{"text": "老门牌换了，旧号码还记得。", "axis": "怀旧"},
{"text": "扛得动的搭把手，扛不动的喊人。", "axis": "侠气"},
{"text": "不赶路的时候，路最好走。", "axis": "逍遥"},
{"text": "自家腌的咸菜，比啥都下饭。", "axis": "烟火"},
{"text": "抽屉分了格，找啥都不慌。", "axis": "秩序"},
{"text": "新东西多看两眼，不亏。", "axis": "求新"},
{"text": "旧曲子哼跑了调，也是自己的调。", "axis": "怀旧"},
{"text": "替人守一会儿摊，算不上吃亏。", "axis": "侠气"},
{"text": "不慌不忙，日子照样往前。", "axis": "逍遥"},
{"text": "咸淡刚好，就是家的味道。", "axis": "烟火"},
{"text": "该谁的就是谁的，一点不乱。", "axis": "秩序"},
{"text": "没见过的，先记在小本上。", "axis": "求新"},
{"text": "旧物件暖手，比新的贴心。", "axis": "怀旧"},
{"text": "有难处言语一声，别自己硬扛。", "axis": "侠气"}
  ]
}
