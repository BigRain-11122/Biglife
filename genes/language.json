{
  "dialects": [
    {"name": "上海话", "words": ["侬晓得伐", "灵额", "结棍", "一眼眼", "帮帮忙", "适意", "搞七捻三", "十三点", "毛毛雨", "事体"], "note": "软糯里带精明"},
