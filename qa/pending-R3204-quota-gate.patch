+# T-20261115-04 换靶线（2026-11-16 R3206）：12h 全城开口配额。
+# 分布实测（R3200·n=80 两个生产日）：recent-dup-phrase 84%、recent-family-opening
+# 66%、opening-family-quota 仅 20%，且单一开口12「这会儿手边最碍事的就是这」占
+# 全部拒稿 30%（24 次）。同人重试已被 R3115 证伪（B 复写同句），故本闸只做一件事：
+# 一个开口12被任一席位硬拒过，就在 12h 内从全城生成面摘掉——命中按既有
+# deferred+1d 契约换人，不再让同人重试（省下 3 次 regen）。只认重复类闸；
+# anchor/引号类拒稿与开口重复无关，不设禁。
+REFUSAL_BAN_HOURS = 12
+REFUSAL_BAN_GATES = frozenset({
+    "recent-dup-opening", "recent-dup-phrase", "recent-family-opening",
+    "opening-family-quota", "today-dup-opening",
+    "batch-dup-opening", "batch-dup-phrase",
+})
+
+
+def recent_refusal_bans(hours=REFUSAL_BAN_HOURS, path=None):
+    """opening12 -> 最近一次被拒时刻；只收重复类闸且窗口内的记录。"""
+    path = path or os.path.join(STATE_DIR, "ring-refusals.jsonl")
+    out = {}
+    try:
+        now = datetime.datetime.now()
+        with open(path, "r", encoding="utf-8") as fh:
+            for ln in fh:
+                ln = ln.strip()
+                if not ln:
+                    continue
+                try:
+                    rec = json.loads(ln)
+                except Exception:  # noqa: BLE001
+                    continue
+                if not (set(rec.get("gate") or []) & REFUSAL_BAN_GATES):
+                    continue
+                op = (rec.get("opening12") or "").strip()
+                if len(op) < 8:
+                    continue
+                try:
+                    ts = datetime.datetime.strptime(rec.get("ts", ""),
+                                                    "%Y-%m-%d %H:%M:%S")
+                except Exception:  # noqa: BLE001
+                    continue
+                if (now - ts) > datetime.timedelta(hours=hours):
+                    continue
+                if op not in out or ts > out[op]:
+                    out[op] = ts
+    except FileNotFoundError:
+        return {}
+    except Exception:  # noqa: BLE001 - 作帐读失败绝不阻断产线
+        return {}
+    return out
+
